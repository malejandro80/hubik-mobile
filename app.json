{
  "expo": {
    "name": "hubik-mobile",
    "slug": "hubik-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hubikmobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hubik.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.hubik.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Hubik necesita acceso al micrófono para que puedas enviar notas de voz en el chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hubik necesita acceso a tus fotos para que puedas publicar imágenes de la propiedad."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Hubik necesita tu ubicación para centrar el mapa al fijar la ubicación de la propiedad."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
