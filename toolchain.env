# ==============================================================================
# Universal Toolchain Configuration (toolchain.env)
# ==============================================================================
# This file allows explicit configuration of the 4 universal runner targets.
# If these variables are left empty, `scripts/verify.sh` will auto-detect your 
# project language and toolchain (Python, TypeScript/Node, Go, Rust, Java, etc.).
#
# To override for your specific stack, uncomment and set the desired commands:

# TEST_CMD="pytest"                     # e.g., "pytest", "cargo test", "go test ./...", "npm test", "vitest run"
# LINT_CMD="ruff check ."               # e.g., "ruff check .", "cargo clippy", "golangci-lint run", "npm run lint"
# BUILD_CMD="python -m build"           # e.g., "cargo build", "go build ./...", "npm run build"
# TYPECHECK_CMD="mypy ."               # e.g., "mypy .", "tsc --noEmit"

# Project metadata
PROJECT_NAME="project-template"
PROJECT_LANGUAGE="auto"                 # auto, python, typescript, javascript, go, rust, java
